# Public browser variables. These are safe to expose in the built Vite app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_URL=https://wordpilot.itscope24.de
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
VITE_AI_GENERATION_ENABLED=true
VITE_IDLE_TIMEOUT_MINUTES=30
VITE_IDLE_WARNING_SECONDS=120

# Leave blank when the Netlify Function API is deployed on the same site.
VITE_API_BASE_URL=

# Server-only variables. Store these as secret environment variables in Netlify.
# Never prefix these with VITE_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_EMAILS=admin@example.com
ADMIN_USER_IDS=
GEMINI_API_KEY=your-gemini-api-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
RESEND_API_KEY=re_your-resend-api-key
BILLING_EMAIL_FROM="WordPilot <billing@your-domain.com>"
APP_URL=https://wordpilot.itscope24.de
PUBLIC_APP_URL=https://wordpilot.itscope24.de
ALLOWED_ORIGINS=https://wordpilot.itscope24.de
