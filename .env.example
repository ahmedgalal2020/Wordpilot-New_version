# Public browser variables. These are safe to expose in the built Vite app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_URL=https://wordpilot.itscope24.de
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
VITE_AI_GENERATION_ENABLED=true
VITE_IDLE_TIMEOUT_MINUTES=30
VITE_IDLE_WARNING_SECONDS=120

# Leave blank when the Node/Express API is served from the same Hostinger/VPS origin.
VITE_API_BASE_URL=

# Server-only variables. Store these as secret environment variables on the Hostinger/VPS runtime.
# Never prefix these with VITE_ and never commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_EMAILS=admin@example.com
ADMIN_USER_IDS=
GEMINI_API_KEY=your-server-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AUDIO_MODEL=gemini-2.5-flash
STRIPE_SECRET_KEY=your-server-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
RESEND_API_KEY=your-server-resend-api-key
BILLING_EMAIL_FROM="WordPilot <billing@your-domain.com>"
SUPPORT_EMAIL_FROM="WordPilot <support@your-domain.com>"
SUPPORT_EMAIL_TO=support@your-domain.com
APP_URL=https://wordpilot.itscope24.de
PUBLIC_APP_URL=https://wordpilot.itscope24.de
ALLOWED_ORIGINS=https://wordpilot.itscope24.de
PORT=3000

# Optional transcript fallback services for YouTube captions when direct requests are blocked.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
YOUTUBE_TRANSCRIPT_PROXY_URL=
YOUTUBE_TRANSCRIPT_HTTP_PROXY=
YOUTUBE_TRANSCRIPT_HTTPS_PROXY=
YOUTUBE_TRANSCRIPT_RELAY_URL=
